{
  "name": "findmyhome-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot with AI that uses Google Docs as knowledge base via OpenRouter",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --watch src --exec ts-node src/index.ts"
  },
  "keywords": ["telegram", "bot", "ai", "google-docs", "openrouter"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "telegraf": "^4.15.0",
    "googleapis": "^128.0.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "natural": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2"
  }
}

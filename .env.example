# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (get from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (default: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Docs Document ID (from document URL)
GOOGLE_DOC_ID=your_google_doc_id_here

# Google Service Account Credentials Path
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# Maximum tokens for context (default: 8000)
MAX_CONTEXT_TOKENS=8000

# Chunk size for text splitting (default: 1000)
CHUNK_SIZE=1000

# Chunk overlap for better context (default: 200)
CHUNK_OVERLAP=200

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (get from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (default: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Docs Document IDs (from document URLs, comma-separated for multiple docs)
# Один документ:
GOOGLE_DOC_IDS=your_google_doc_id_here
# Несколько документов (через запятую):
# GOOGLE_DOC_IDS=doc_id_1,doc_id_2,doc_id_3

# Старый формат (для обратной совместимости, используйте GOOGLE_DOC_IDS)
# GOOGLE_DOC_ID=your_google_doc_id_here

# Google Service Account Credentials Path
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# Maximum tokens for context (default: 12000)
MAX_CONTEXT_TOKENS=12000

# Chunk size for text splitting (default: 2000)
CHUNK_SIZE=2000

# Chunk overlap for better context (default: 400)
CHUNK_OVERLAP=400
